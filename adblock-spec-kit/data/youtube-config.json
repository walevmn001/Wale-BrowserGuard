{
  "version": 1,
  "enabled": false,
  "layers": {
    "network": true,
    "prune": true,
    "cosmetic": true,
    "skip": true,
    "health": true
  },
  "adFields": ["adPlacements", "playerAds", "adSlots"],
  "endpoints": [
    "/pagead/",
    "/api/stats/ads",
    "/api/stats/atr",
    "/pcs/activeview",
    "/youtubei/v1/player/ad_break"
  ],
  "selectors": [
    ".ytp-ad-module",
    ".ytp-ad-overlay-container",
    ".ytp-ad-text-overlay",
    "ytd-ad-slot-renderer",
    "ytd-display-ad-renderer",
    "ytd-promoted-sparkles-web-renderer",
    "ytd-promoted-video-renderer",
    "ytd-in-feed-ad-layout-renderer",
    "ytd-banner-promo-renderer",
    "ytd-statement-banner-renderer",
    "#masthead-ad"
  ],
  "skipSelectors": [".ytp-ad-skip-button", ".ytp-ad-skip-button-modern", ".ytp-skip-ad-button"]
}
