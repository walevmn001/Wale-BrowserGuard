{
  "manifest_version": 3,
  "name": "A-4 Instrumentation — MAIN/ISOLATED start order (verification only)",
  "version": "0.1.0",
  "description": "Standalone instrumentation for verification A-4 (T067). Independent from WALE GUARD production.",
  "permissions": ["storage"],
  "host_permissions": ["*://*.youtube.com/*"],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["isolated.js"],
      "run_at": "document_start",
      "world": "ISOLATED",
      "all_frames": false
    },
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["main.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ]
}
